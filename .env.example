# ==============================================================================
# InboxIQ SaaS — Production Environment Configuration (.env.example)
# ==============================================================================

# Control Plane & App Domain
NEXT_PUBLIC_APP_URL=https://www.inboxiq.online

# 1. Clerk Authentication (Identity & Session Layer)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# 2. Supabase PostgreSQL & RLS (Control Plane Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. Google OAuth 2.0 (Gmail API & Google Drive API)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=https://www.inboxiq.online/api/google/callback

# 4. Token Encryption Key (AES-256-GCM Hardware/Server-Backed Secret)
# Generate a secure 32-byte (64 hex characters) key: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# 5. Razorpay Payments & Subscriptions Gateway
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_WEBHOOK_SECRET=...

# Razorpay Recurring Plan IDs (Configured in Razorpay Dashboard)
RAZORPAY_PLAN_ID_FACULTY_INR=plan_...
RAZORPAY_PLAN_ID_STUDENT_INR=plan_...
RAZORPAY_PLAN_ID_PROFESSIONAL_INR=plan_...

# 6. n8n Automation Engine (External Intelligence Boundary)
N8N_BASE_URL=https://n8n.yourdomain.com
N8N_WEBHOOK_SECRET=inboxiq-n8n-shared-hmac-secret

# 7. SMTP Email Configuration (Nodemailer Lifecycle & Contact Delivery)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-service-email@gmail.com
EMAIL_PASSWORD=your-app-specific-password
EMAIL_FROM=InboxIQ <no-reply@inboxiq.online>
EMAIL_TO=admin@inboxiq.online

# 8. Administrator Access Control
ADMIN_EMAILS=admin@inboxiq.online
ADMIN_EMAIL=admin@inboxiq.online

# 9. Vercel Cron Security
CRON_SECRET=your-cron-secret-bearer-token

# 10. Admin Alert Webhook (Discord/Slack — Optional)
ADMIN_ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...
